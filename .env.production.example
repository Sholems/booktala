# Production template. Copy to .env on the server, fill in the blanks, then run
#   php artisan key:generate
#   php artisan app:production-check
# Never commit the real .env.

APP_NAME="BookTala"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
TRUSTED_PROXIES=*
APP_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BOOKING_PROCESSING_FEE=2000
BOOKING_CAUTION_FEE=20000
BOOKING_HOLD_MINUTES=15

# Diagnostics dashboard: records every request. Leave off in production.
TELESCOPE_ENABLED=false

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MERCHANT_EMAIL=
PAYSTACK_CONNECT_TIMEOUT=5
PAYSTACK_TIMEOUT=15

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL on Coolify's private network.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional Cloudflare R2. Set FILESYSTEM_DISK=r2 and create two buckets. Only
# the public bucket may have a public/custom domain; keep the private bucket closed.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_PRIVATE_BUCKET=
CLOUDFLARE_R2_DEFAULT_REGION=auto
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
